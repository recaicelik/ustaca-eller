# --- Unity ---
unity/[Ll]ibrary/
unity/[Tt]emp/
unity/[Oo]bj/
unity/[Bb]uild/
unity/[Bb]uilds/
unity/[Ll]ogs/
unity/[Uu]ser[Ss]ettings/
unity/[Mm]emoryCaptures/
unity/[Rr]ecordings/
unity/Assets/AssetStoreTools*
unity/Assets/Plugins/Editor/JetBrains*
unity/.vs/
unity/.gradle/
unity/ExportedObj/
# Unity regenerates these from the .asmdef files. Scoped to unity/ on purpose —
# core/ has hand-written project files that must stay tracked.
unity/*.csproj
unity/*.unityproj
unity/*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties
sysinfo.txt

# --- Art: intermediate output stays out; sources live in Git LFS (.gitattributes) ---
*_export/
*.tmp.png

# --- .NET (core/) ---
# Build output lives outside the package folder so Unity never imports a compiled
# copy of an assembly it also builds from source. See core/Directory.Build.props.
core/.build/
[Bb]in/
[Oo]bj/

# Unity regenerates these per machine
unity/.vscode/

# --- Tooling ---
node_modules/
.DS_Store
*.log

# --- Secrets: RevenueCat keys, signing certificates, service accounts ---
.env
.env.*
*.p12
*.mobileprovision
*.keystore
!debug.keystore
secrets/
