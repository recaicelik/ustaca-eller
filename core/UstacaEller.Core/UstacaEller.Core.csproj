<Project Sdk="Microsoft.NET.Sdk">

  <!--
    netstandard2.1 is what Unity consumes. This project exists so the game logic can
    be compiled and tested without Unity installed; Unity itself compiles the same
    files from source through Runtime/UstacaEller.Core.asmdef.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>UstacaEller.Core</RootNamespace>
    <AssemblyName>UstacaEller.Core</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Runtime/**/*.cs" />
  </ItemGroup>

</Project>
