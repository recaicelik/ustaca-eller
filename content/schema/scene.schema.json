{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ustacaeller.app/schema/scene.schema.json",
  "title": "Ustaca Eller — Scene Manifest",
  "description": "Describes a whole scene as data. Adding a scene must never require writing C#. All human-readable text is referenced by key (see content/i18n) so a new language costs zero manifest edits.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "titleKey", "canvas", "budget", "assets", "layers", "objects"],
  "properties": {
    "$schema": { "type": "string" },

    "schemaVersion": { "const": 1 },

    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Scene id. The Addressable group name derives from this."
    },

    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Content version. The client compares this when checking for remote updates."
    },

    "titleKey": {
      "type": "string",
      "pattern": "^scene\\.[a-z0-9_]+\\.title$",
      "description": "Localization key, resolved against content/i18n. Never put literal text here."
    },

    "canvas": {
      "type": "object",
      "description": "Design resolution every coordinate in this file is expressed in. Origin is top-left, y grows downward — the convention art tools use. The runtime maps it to world space; scene authors never think in world units.",
      "required": ["width", "height"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "number", "minimum": 320, "maximum": 8192 },
        "height": { "type": "number", "minimum": 320, "maximum": 8192 }
      }
    },

    "budget": {
      "type": "object",
      "description": "Reference-device (entry-level Android) budget. The validator enforces it.",
      "required": ["maxActiveSprites", "maxSkeletons"],
      "additionalProperties": false,
      "properties": {
        "maxActiveSprites": { "type": "integer", "minimum": 1, "maximum": 180 },
        "maxSkeletons": { "type": "integer", "minimum": 0, "maximum": 6 },
        "targetFrameMs": { "type": "number", "minimum": 8, "maximum": 33.4 }
      }
    },

    "assets": {
      "type": "object",
      "required": ["atlases"],
      "additionalProperties": false,
      "properties": {
        "atlases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "file"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "file": { "type": "string", "minLength": 1 },
              "sprites": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "description": "Sprite names inside the atlas. When present, the validator checks object references against it. Art must never contain baked-in text — that would make every sprite a localized asset."
              }
            }
          }
        },
        "skeletons": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "file", "type"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "file": { "type": "string", "minLength": 1 },
              "type": { "enum": ["rive", "spine"] }
            }
          }
        },
        "audio": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "file", "type"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "file": { "type": "string", "minLength": 1 },
              "type": {
                "enum": ["sfx", "ambience", "voice"],
                "description": "'voice' is localized: the runtime resolves it under audio/<locale>/<file>. 'sfx' and 'ambience' are shared across locales."
              }
            }
          }
        }
      }
    },

    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "order"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "order": { "type": "integer", "minimum": 0, "maximum": 100 },
          "parallax": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },

    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "layer", "sprite", "transform"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "layer": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "sprite": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*:[a-z0-9_]+$",
            "description": "Format: atlasId:spriteName"
          },
          "transform": {
            "type": "object",
            "required": ["x", "y"],
            "additionalProperties": false,
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "rotation": { "type": "number", "minimum": -360, "maximum": 360 },
              "scale": { "type": "number", "minimum": 0.05, "maximum": 10 }
            }
          },
          "labelVoice": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "Voice clip spoken when the child taps the object ('this is dough'). Must reference an audio asset of type 'voice'. This is the main localized asset in the product — the age group reads almost nothing."
          },
          "mechanics": {
            "type": "array",
            "items": { "enum": ["glue", "paint", "cut", "build"] },
            "description": "Which mechanics are active on this object. Each requires a config block of the same name."
          },
          "glue": {
            "type": "object",
            "required": ["acceptedBy"],
            "additionalProperties": false,
            "properties": {
              "acceptedBy": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 },
                "description": "Zone ids that accept this object. Trailing * acts as a wildcard."
              },
              "snapSfx": { "type": "string" },
              "returnOnMiss": {
                "type": "boolean",
                "description": "Return to origin when dropped somewhere invalid. Defaults to true — a lost object is a dead end for a four-year-old."
              }
            }
          },
          "paint": {
            "type": "object",
            "required": ["maskFile"],
            "additionalProperties": false,
            "properties": {
              "maskFile": {
                "type": "string",
                "minLength": 1,
                "description": "Defines fill regions. Used instead of a real flood fill: cheaper, and far more predictable for a small child."
              },
              "brushSfx": { "type": "string" },
              "fillSfx": { "type": "string" }
            }
          },
          "cut": {
            "type": "object",
            "required": ["minPieceArea", "maxPieces"],
            "additionalProperties": false,
            "properties": {
              "minPieceArea": {
                "type": "number",
                "minimum": 0.01,
                "maximum": 0.5,
                "description": "Fraction of the original area. Smaller pieces are never produced — they look wrong and small fingers cannot grab them."
              },
              "maxPieces": { "type": "integer", "minimum": 2, "maximum": 12 },
              "cutSfx": { "type": "string" }
            }
          },
          "build": {
            "type": "object",
            "required": ["gridZone"],
            "additionalProperties": false,
            "properties": {
              "gridZone": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "settleSfx": { "type": "string" }
            }
          }
        }
      }
    },

    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "shape"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "type": { "enum": ["snap", "grid", "paintArea"] },
          "shape": {
            "type": "object",
            "required": ["x", "y", "width", "height"],
            "additionalProperties": false,
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "width": { "type": "number", "minimum": 1 },
              "height": { "type": "number", "minimum": 1 }
            }
          },
          "accepts": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "description": "Object id patterns this zone accepts. Trailing * acts as a wildcard."
          },
          "grid": {
            "type": "object",
            "required": ["columns", "rows"],
            "additionalProperties": false,
            "properties": {
              "columns": { "type": "integer", "minimum": 1, "maximum": 20 },
              "rows": { "type": "integer", "minimum": 1, "maximum": 20 }
            }
          },
          "snapRadius": { "type": "number", "minimum": 8, "maximum": 400 }
        }
      }
    },

    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "skeleton", "transform"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "skeleton": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "artboard": { "type": "string" },
          "stateMachine": { "type": "string" },
          "transform": {
            "type": "object",
            "required": ["x", "y"],
            "additionalProperties": false,
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" },
              "scale": { "type": "number", "minimum": 0.05, "maximum": 10 }
            }
          },
          "reactions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["on", "input"],
              "additionalProperties": false,
              "properties": {
                "on": { "enum": ["sceneEnter", "objectTapped", "objectCut", "objectPainted", "objectSnapped", "idleTimeout"] },
                "target": { "type": "string", "description": "Object id pattern. Empty means any object." },
                "input": { "type": "string", "minLength": 1, "description": "Rive/Spine state machine input name." },
                "voice": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "description": "Optional localized voice clip played with the reaction." }
              }
            }
          }
        }
      }
    },

    "audio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ambience": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "ambienceVolume": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
